---
import BaseHead from '../components/BaseHead.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
import ProjectOrigin from '../components/ProjectOrigin.astro';
import { defaultLang, localeTag, localizePath, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author: string;
  tags: string[];
  category: string;
  heroImage?: string;
  canonical?: string;
  lang?: Lang;
  alternates?: { lang: Lang; url: string }[];
  origin?: { project: string; repo: string; summary: string };
}

const props = Astro.props;
const lang = props.lang ?? defaultLang;
const alternates = props.alternates ?? [];
const t = useTranslations(lang);
const other = alternates.find((a) => a.lang !== lang);
const url = new URL(Astro.url.pathname, Astro.site).toString();
const siteName = 'Ascendy Engineering';
const siteUrl = Astro.site?.toString() ?? 'https://blog.ascendy.ai';
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead
      title={props.title}
      description={props.description}
      canonical={props.canonical}
      image={props.heroImage}
      ogType="article"
      lang={lang}
      alternates={alternates}
    />
    <SchemaOrg
      type="BlogPosting"
      url={url}
      title={props.title}
      description={props.description}
      author={props.author}
      pubDate={props.pubDate}
      updatedDate={props.updatedDate}
      image={props.heroImage}
      tags={props.tags}
      category={props.category}
      siteName={siteName}
      siteUrl={siteUrl}
      lang={localeTag[lang]}
    />
  </head>
  <body>
    <header class="prose-ascendy !py-6 flex items-baseline justify-between">
      <a href={localizePath('/', lang)} class="text-sm text-neutral-500 hover:text-neutral-900">← Ascendy</a>
      {other && <a href={other.url} class="text-sm text-neutral-500 hover:text-neutral-900">{t('switchLabel')}</a>}
    </header>

    <article class="prose-ascendy">
      <p class="text-xs uppercase tracking-wide text-neutral-500">{props.category}</p>
      <h1>{props.title}</h1>
      <p class="text-sm text-neutral-500">
        <time datetime={props.pubDate.toISOString()}>
          {props.pubDate.toISOString().slice(0, 10)}
        </time>
        · {props.author}
      </p>
      <hr />
      <slot />
      {props.origin && <ProjectOrigin origin={props.origin} lang={lang} />}
      <hr />
      <p class="text-xs text-neutral-500">
        {t('tags')}: {props.tags.join(', ')}
      </p>
    </article>
  </body>
</html>
