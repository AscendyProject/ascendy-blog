---
import BaseHead from '../components/BaseHead.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
import ProjectOrigin from '../components/ProjectOrigin.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { defaultLang, localeTag, localizePath, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author: string;
  tags: string[];
  category: string;
  heroImage?: string;
  canonical?: string;
  lang?: Lang;
  alternates?: { lang: Lang; url: string }[];
  origin?: { project: string; repo: string; summary: string };
}

const props = Astro.props;
const lang = props.lang ?? defaultLang;
const alternates = props.alternates ?? [];
const t = useTranslations(lang);
const other = alternates.find((a) => a.lang !== lang);
const url = new URL(Astro.url.pathname, Astro.site).toString();
const siteName = 'Ascendy Engineering';
const siteUrl = Astro.site?.toString() ?? 'https://blog.ascendy.ai';
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead
      title={props.title}
      description={props.description}
      canonical={props.canonical}
      image={props.heroImage}
      ogType="article"
      lang={lang}
      alternates={alternates}
    />
    <SchemaOrg
      type="BlogPosting"
      url={url}
      title={props.title}
      description={props.description}
      author={props.author}
      pubDate={props.pubDate}
      updatedDate={props.updatedDate}
      image={props.heroImage}
      tags={props.tags}
      category={props.category}
      siteName={siteName}
      siteUrl={siteUrl}
      lang={localeTag[lang]}
    />
  </head>
  <body>
    <header class="prose-ascendy !py-6 flex items-center justify-between gap-4">
      <a href={localizePath('/', lang)} class="text-sm">← Ascendy</a>
      <nav class="flex flex-wrap items-center justify-end gap-x-4 gap-y-2 text-sm">
        <a href="https://ascendy.ai" target="_blank" rel="noopener">{t('navService')}</a>
        {other && <a href={other.url}>{t('switchLabel')}</a>}
        <ThemeToggle lang={lang} />
      </nav>
    </header>

    <article class="prose-ascendy">
      <p class="text-xs uppercase tracking-wide u-muted">{props.category}</p>
      <h1>{props.title}</h1>
      <p class="text-sm u-muted">
        <time datetime={props.pubDate.toISOString()}>
          {props.pubDate.toISOString().slice(0, 10)}
        </time>
        · {props.author}
      </p>
      <hr />
      <slot />
      {props.origin && <ProjectOrigin origin={props.origin} lang={lang} />}
      <hr />
      <p class="text-xs u-muted">
        {t('tags')}: {props.tags.join(', ')}
      </p>
    </article>
  </body>
</html>
