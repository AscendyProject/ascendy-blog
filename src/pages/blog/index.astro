---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { localizePath, useTranslations } from '../../i18n/ui';

const lang = 'ko' as const;
const t = useTranslations(lang);
const alternates = [
  { lang: 'ko' as const, url: '/blog/' },
  { lang: 'en' as const, url: '/en/blog/' },
];

const posts = (await getCollection('blog', ({ data }) => !data.draft && data.redactionReviewed && data.lang === lang))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="글 — Ascendy Engineering"
  description="Ascendy 엔지니어링 블로그의 전체 글 목록"
  schemaType="CollectionPage"
  lang={lang}
  alternates={alternates}
>
  <section class="prose-ascendy">
    <h1>{t('postsTitle')}</h1>
    <ul class="post-list space-y-2">
      {posts.map((post) => (
        <li>
          <a href={localizePath(`/blog/${post.id}/`, lang)} class="post-card">
            <span class="pc-meta">{post.data.category} · {post.data.pubDate.toISOString().slice(0, 10)}</span>
            <span class="pc-title">{post.data.title}</span>
            <span class="pc-desc">{post.data.description}</span>
          </a>
        </li>
      ))}
      {posts.length === 0 && (
        <li style="color:var(--muted)">{t('homeEmpty')}</li>
      )}
    </ul>
  </section>
</BaseLayout>
