---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { localizePath, useTranslations } from '../i18n/ui';

const lang = 'ko' as const;
const t = useTranslations(lang);
const alternates = [
  { lang: 'ko' as const, url: '/' },
  { lang: 'en' as const, url: '/en/' },
];

const posts = (await getCollection('blog', ({ data }) => !data.draft && data.redactionReviewed && data.lang === lang))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 10);
---

<BaseLayout
  title="Ascendy Engineering"
  description="Ascendy 백엔드·프론트엔드·인프라 페어 에이전트의 결정과 트레이드오프를 LMO를 의식해 공개하는 엔지니어링 블로그."
  schemaType="WebSite"
  lang={lang}
  alternates={alternates}
>
  <section class="prose-ascendy">
    <h1>Ascendy Engineering</h1>
    <p>{t('homeTagline')}</p>

    <h2>{t('homeRecent')}</h2>
    <ul class="post-list space-y-2">
      {posts.map((post) => (
        <li>
          <a href={localizePath(`/blog/${post.id}/`, lang)} class="post-card">
            <span class="pc-meta">{post.data.category} · {post.data.pubDate.toISOString().slice(0, 10)}</span>
            <span class="pc-title">{post.data.title}</span>
            <span class="pc-desc">{post.data.description}</span>
          </a>
        </li>
      ))}
      {posts.length === 0 && (
        <li style="color:var(--muted)">{t('homeEmpty')}</li>
      )}
    </ul>
  </section>
</BaseLayout>
