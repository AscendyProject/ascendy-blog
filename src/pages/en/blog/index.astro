---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { localizePath, useTranslations } from '../../../i18n/ui';

const lang = 'en' as const;
const t = useTranslations(lang);
const alternates = [
  { lang: 'ko' as const, url: '/blog/' },
  { lang: 'en' as const, url: '/en/blog/' },
];

const posts = (await getCollection('blog', ({ data }) => !data.draft && data.redactionReviewed && data.lang === lang))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Posts — Ascendy Engineering"
  description="All posts on the Ascendy Engineering blog."
  schemaType="CollectionPage"
  lang={lang}
  alternates={alternates}
>
  <section class="prose-ascendy">
    <h1>{t('postsTitle')}</h1>
    <ul class="space-y-6">
      {posts.map((post) => (
        <li>
          <p class="text-xs uppercase tracking-wide text-neutral-500">
            {post.data.category} · <time>{post.data.pubDate.toISOString().slice(0, 10)}</time>
          </p>
          <a href={localizePath(`/blog/${post.id}/`, lang)} class="text-lg font-medium">{post.data.title}</a>
          <p class="text-sm text-neutral-500">{post.data.description}</p>
        </li>
      ))}
      {posts.length === 0 && (
        <li class="text-neutral-500">{t('homeEmpty')}</li>
      )}
    </ul>
  </section>
</BaseLayout>
