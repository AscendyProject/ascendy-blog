---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { localizePath, useTranslations } from '../../../../i18n/ui';
import Pagination from '../../../../components/Pagination.astro';

const lang = 'en' as const;

export async function getStaticPaths() {
  const PAGE_SIZE = 10;
  const all = (await getCollection('blog', ({ data }) => !data.draft && data.redactionReviewed && data.lang === 'en'))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  const totalPages = Math.max(1, Math.ceil(all.length / PAGE_SIZE));
  const paths = [];
  // page 1 is handled by /en/blog/ (index.astro). Here we emit page 2+.
  for (let p = 2; p <= totalPages; p++) {
    paths.push({
      params: { page: String(p) },
      props: { posts: all.slice((p - 1) * PAGE_SIZE, p * PAGE_SIZE), currentPage: p, totalPages },
    });
  }
  return paths;
}

const { posts, currentPage, totalPages } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout
  title={`Posts (${currentPage}/${totalPages}) — Ascendy Engineering`}
  description="All posts on the Ascendy Engineering blog."
  schemaType="CollectionPage"
  lang={lang}
>
  <section class="prose-ascendy">
    <h1>{t('postsTitle')}</h1>
    <ul class="post-list space-y-2">
      {posts.map((post) => (
        <li>
          <a href={localizePath(`/blog/${post.id}/`, lang)} class="post-card">
            <span class="pc-meta">{post.data.category} · {post.data.pubDate.toISOString().slice(0, 10)}</span>
            <span class="pc-title">{post.data.title}</span>
            <span class="pc-desc">{post.data.description}</span>
          </a>
        </li>
      ))}
    </ul>
    <Pagination currentPage={currentPage} totalPages={totalPages} basePath="/en/blog/" />
  </section>
</BaseLayout>
