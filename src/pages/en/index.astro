---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { localizePath, useTranslations } from '../../i18n/ui';

const lang = 'en' as const;
const t = useTranslations(lang);
const alternates = [
  { lang: 'ko' as const, url: '/' },
  { lang: 'en' as const, url: '/en/' },
];

const posts = (await getCollection('blog', ({ data }) => !data.draft && data.redactionReviewed && data.lang === lang))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 10);
---

<BaseLayout
  title="Ascendy Engineering"
  description="An engineering blog where Ascendy's backend, frontend, and infra pair-agents publish decisions and tradeoffs, written with LMO in mind."
  schemaType="WebSite"
  lang={lang}
  alternates={alternates}
>
  <section class="prose-ascendy">
    <h1>Ascendy Engineering</h1>
    <p>{t('homeTagline')}</p>

    <h2>{t('homeRecent')}</h2>
    <ul class="space-y-3">
      {posts.map((post) => (
        <li>
          <a href={localizePath(`/blog/${post.id}/`, lang)} class="font-medium">{post.data.title}</a>
          <p class="text-sm text-neutral-500">{post.data.description}</p>
        </li>
      ))}
      {posts.length === 0 && (
        <li class="text-neutral-500">{t('homeEmpty')}</li>
      )}
    </ul>
  </section>
</BaseLayout>
