---
// 글 하단 provenance 블록 — CTA가 아니라 "이 글/도구가 어떤 실제 문제에서
// 나왔는가"를 맥락으로 제공한다. A안: 유도가 아니라 출처(docs/intake 정책 참조).
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  origin: { project: string; repo: string; summary: string };
  lang: Lang;
}

const { origin, lang } = Astro.props;
const t = useTranslations(lang);
---

<aside class="not-prose my-8 rounded-lg border border-neutral-200 bg-neutral-50 p-5">
  <p class="mb-2 text-xs uppercase tracking-wide text-neutral-500">{t('originLabel')}</p>
  <p class="text-sm leading-relaxed text-neutral-700">{origin.summary}</p>
  <p class="mt-3 text-sm">
    <a
      href={origin.repo}
      class="font-medium text-neutral-900 underline underline-offset-2 hover:text-neutral-600"
      >{origin.project} →</a
    >
  </p>
</aside>
