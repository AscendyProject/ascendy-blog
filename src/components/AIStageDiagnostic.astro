      ],
      stages: {
        1: { name: "Stage 1 · Not using it", cls: "s1", desc: "You haven't brought AI into your daily work yet. That's not bad — it just means the biggest jump is still ahead. The next step is surprisingly easy: ask AI the next thing you'd have searched for." },
        2: { name: "Stage 2 · Asking", cls: "s2", desc: "You've started asking AI instead of searching — using it as a 'smarter search box.' Next: go from asking to delegating. Beyond getting answers, hand it a draft or a summary." },
        3: { name: "Stage 3 · Delegating tasks", cls: "s3", choke: true, desc: "You hand one-off tasks to AI. This is where productivity jumps — which is exactly why most people stop here. The very next step is the hardest wall to cross; be sure to read below." },
        4: { name: "Stage 4 · Handing off the work", cls: "s4", desc: "You crossed the wall most people don't. Beyond one-off tasks, you've re-architected the workflow itself around AI — you changed how you work, not just which tool you use. Next is building." },
        5: { name: "Stage 5 · Building", cls: "s5", desc: "You build tools and services with AI — you've crossed from consumer to producer. Developers via code, non-developers via no-code; different paths, same stage. The last step is making AI 'work on its own.'" },
        6: { name: "Stage 6 · Making AI do the work", cls: "s6", desc: "The top. You've built systems where AI works on its own. But it's wide here too — from slotting in one automation, to an organization of agents passing work to each other. Even within Stage 6 there are layers." },
      },
      stageLinks: {
        1: "#stage-1-not-using-it",
        2: "#stage-2-asking",
        3: "#stage-3-delegating-tasks",
        4: "#stage-4-handing-off-the-work",
        5: "#stage-5-building",
        6: "#stage-6-making-ai-do-the-work",
      },
      pos: "Your current position",
      retry: "↻ Retake",
      learnMore: (s) => `More on Stage ${s}`,
      copy: "Copy link",
      copied: "Copied!",
      copyFail: "Couldn't copy — long-press to copy",
      shareNative: "Share…",
      shareText: (s) => `I'm at Stage ${s} of using AI. Where are you?`,
      chokeTitle: "3 → 4: most people stop here",
      chokeBody: "“Delegating tasks” is ‘AI is the tool, I'm the driver.’ “Handing off the work” is ‘re-architecting the work so AI does it.’ It takes a shift in mindset, not skill — even heavy AI users sometimes never cross it.",
      shareHint: "Share your result:",
    },
  };

  (function () {
    const wrap = document.getElementById("diagnostic") as HTMLElement | null;
    if (!wrap) return;
    const lang = wrap.dataset.lang === "en" ? "en" : "ko";
    const T = STR[lang];
    const questions = T.questions;
    const stages = T.stages;

    let current = 0;
    let locked = false;
    const answers: number[] = [];
    const intro = document.getElementById("intro") as HTMLElement;
    const quiz = document.getElementById("quiz") as HTMLElement;
    const resultEl = document.getElementById("result") as HTMLElement;
    const qText = document.getElementById("q-text") as HTMLElement;
    const optionsEl = document.getElementById("options") as HTMLElement;
    const bar = document.getElementById("bar") as HTMLElement;
    const counter = document.getElementById("counter") as HTMLElement;
    const startBtn = document.getElementById("start-btn") as HTMLButtonElement;

    startBtn.addEventListener("click", function () {
      intro.classList.add("hidden");
      quiz.classList.remove("hidden");
      render();
    });

    function render() {
      locked = false;
      const item = questions[current];
      qText.textContent = item.q;
      counter.textContent = current + 1 + "/" + questions.length;
      bar.style.width = ((current + 1) / questions.length) * 100 + "%";
      optionsEl.innerHTML = "";
      item.opts.forEach(function (o) {
        const b = document.createElement("button");
        b.className = "opt";
        b.setAttribute("role", "radio");
        b.setAttribute("aria-checked", "false");
        const dot = document.createElement("span");
        dot.className = "dot";
        const label = document.createElement("span");
        label.className = "opt-t";
        label.textContent = o.t;
        b.appendChild(dot);
        b.appendChild(label);
        b.addEventListener("click", function () {
          if (locked) return;
          locked = true;
          // 선택 피드백: 고른 항목 강조 후 잠깐 보여주고 다음으로
          b.classList.add("selected");
          b.setAttribute("aria-checked", "true");
          Array.from(optionsEl.querySelectorAll("button")).forEach(function (el) {
            (el as HTMLButtonElement).disabled = true;
          });
          answers.push(o.s);
          window.setTimeout(function () {
            current++;
            if (current < questions.length) {
              render();
            } else {
              finish();
            }
          }, 320);
        });
        optionsEl.appendChild(b);
      });
    }

    function finish() {
      quiz.classList.add("hidden");
      const avg =
        answers.reduce(function (a, b) {
          return a + b;
        }, 0) / answers.length;
      const s = Math.max(1, Math.min(6, Math.round(avg))) as StageKey;
      const st = stages[s];
      resultEl.classList.remove("hidden");

      let chokeHtml = "";
      if (st.choke) {
        chokeHtml =
          '<div class="choke"><p class="ct">' +
          T.chokeTitle +
          '</p><p class="cb">' +
          T.chokeBody +
          "</p></div>";
      }

      // 공유 URL은 항상 진단 앵커를 달아, 받은 사람이 바로 설문에 착지하게.
      const shareUrl = location.origin + location.pathname + "#diagnostic";
      const shareText = T.shareText(s);
      const xHref =
        "https://twitter.com/intent/tweet?text=" +
        encodeURIComponent(shareText) +
        "&url=" +
        encodeURIComponent(shareUrl);
      const liHref =
        "https://www.linkedin.com/sharing/share-offsite/?url=" +
        encodeURIComponent(shareUrl);

      const canNativeShare = typeof navigator !== "undefined" && !!navigator.share;
      const nativeBtn = canNativeShare
        ? '<button id="nshare" class="icon-btn">' + T.shareNative + "</button>"
        : "";

      resultEl.innerHTML =
        '<div class="result-card ' +
        st.cls +
        '"><p class="pos">' +
        T.pos +
        '</p><p class="stage">' +
        st.name +
        '</p><p class="desc">' +
        st.desc +
        "</p></div>" +
        chokeHtml +
        '<div class="actions">' +
        '<button id="retry">' +
        T.retry +
        "</button>" +
        '<a href="' +
        (T.stageLinks[s] || "#") +
        '"><button>' +
        T.learnMore(s) +
        "</button></a>" +
        '<p class="share-label">' +
        T.shareHint +
        "</p>" +
        '<button id="copy" class="icon-btn">' +
        T.copy +
        "</button>" +
        '<a href="' +
        xHref +
        '" target="_blank" rel="noopener"><button class="icon-btn">X</button></a>' +
        '<a href="' +
        liHref +
        '" target="_blank" rel="noopener"><button class="icon-btn">LinkedIn</button></a>' +
        nativeBtn +
        "</div>";

      const retryBtn = document.getElementById("retry") as HTMLButtonElement;
      retryBtn.addEventListener("click", function () {
        answers.length = 0;
        current = 0;
        resultEl.classList.add("hidden");
        resultEl.innerHTML = "";
        quiz.classList.remove("hidden");
        render();
      });

      const copyBtn = document.getElementById("copy") as HTMLButtonElement | null;
      if (copyBtn) {
        copyBtn.addEventListener("click", function () {
          const flash = function (label: string) {
            copyBtn.textContent = label;
            window.setTimeout(function () {
              copyBtn.textContent = T.copy;
            }, 1500);
          };
          // 실제 복사가 됐을 때만 "복사됨"을 표시한다 — 권한 거부/비보안
          // 컨텍스트에서 거짓 성공이 뜨지 않도록. legacy execCommand 폴백 후
          // 그래도 실패하면 실패 상태를 표시.
          const legacyCopy = function (): boolean {
            const ta = document.createElement("textarea");
            ta.value = shareUrl;
            ta.setAttribute("readonly", "");
            ta.style.position = "fixed";
            ta.style.top = "-9999px";
            document.body.appendChild(ta);
            ta.select();
            try {
              return document.execCommand("copy");
            } catch {
              return false;
            } finally {
              // execCommand가 throw해도 숨은 textarea가 DOM에 남지 않도록
              document.body.removeChild(ta);
            }
          };
          const onFail = function () {
            if (legacyCopy()) flash(T.copied);
            else flash(T.copyFail);
          };
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(shareUrl).then(function () {
              flash(T.copied);
            }).catch(onFail);
          } else {
            onFail();
          }
        });
      }

      const nshare = document.getElementById("nshare") as HTMLButtonElement | null;
      if (nshare) {
        nshare.addEventListener("click", function () {
          if (navigator.share) {
            navigator
              .share({ title: shareText, text: shareText, url: shareUrl })
              .catch(function () {});
          }
        });
      }
    }
  })();
</script>
