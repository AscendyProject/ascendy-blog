---
// AI 활용 단계 자가진단 도구 컴포넌트
// HTML 진단 도구를 Astro 컴포넌트로 변환
---

<div class="wrap">
  <div id="intro" class="card">
    <h2>AI 활용 6단계, 당신은 몇 단계?</h2>
    <p class="lead">단계를 직접 고르는 게 아니라, 평소 행동 5개로 당신의 위치를 역산합니다. 솔직하게 "가장 가까운 것"을 고르세요. 1분이면 끝납니다.</p>
    <button id="start-btn">진단 시작 →</button>
  </div>

  <div id="quiz" class="hidden">
    <div class="progress">
      <div class="bar-track"><div id="bar" class="bar-fill"></div></div>
      <span id="counter" class="counter">1/5</span>
    </div>
    <p id="q-text" class="q-text"></p>
    <div id="options" class="options"></div>
  </div>

  <div id="result" class="hidden"></div>

  <details class="lmo">
    <summary>이 진단의 단계 정의 (참고)</summary>
    <p>AI 활용 단계는 행동의 성격으로 구분한다. 1단계 안 쓴다. 2단계 묻는다(검색 대신 AI에 질문). 3단계 시킨다(글 초안·요약·번역 등 단발 작업 위임). 4단계 일을 맡긴다(반복 업무를 AI 중심으로 재설계). 5단계 만든다(웹·앱·자동화 도구 직접 제작, 개발자는 코드로 비개발자는 노코드로). 6단계 AI가 일하게 만든다(에이전트·자동화 시스템 구축). 가장 넘기 어려운 구간은 3→4로, 능력이 아니라 사고방식의 전환이 필요하다. 채점은 행동 질문 5개 점수의 평균을 반올림해 1~6으로 산출한다.</p>
  </details>
</div>

<style>
  :root {
    --bg: #ffffff;
    --surface: #f4f3ee;
    --text: #1a1a18;
    --text-muted: #5f5e5a;
    --border: rgba(0, 0, 0, 0.12);
    --accent: #185fa5;
    --radius: 12px;
    --radius-sm: 8px;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #1f1f1d;
      --surface: #2a2a27;
      --text: #f0efe9;
      --text-muted: #b4b2a9;
      --border: rgba(255, 255, 255, 0.15);
      --accent: #85b7eb;
    }
  }
  .wrap { max-width: 640px; margin: 0 auto; padding: 2rem 1.25rem 3rem; }
  .card {
    background: var(--bg);
    border: 0.5px solid var(--border);
    border-radius: var(--radius);
    padding: 1.75rem;
  }
  .card h2 { font-size: 22px; font-weight: 500; margin: 0 0 8px; }
  .lead { font-size: 15px; color: var(--text-muted); margin: 0 0 1.5rem; }
  button {
    font: inherit;
    color: var(--text);
    background: transparent;
    border: 0.5px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 10px 18px;
    cursor: pointer;
    transition: background 0.15s, transform 0.05s;
  }
  button:hover { background: var(--surface); }
  button:active { transform: scale(0.98); }
  .progress { display: flex; align-items: center; gap: 10px; margin: 0 0 1.25rem; }
  .bar-track { flex: 1; height: 6px; background: var(--surface); border-radius: 3px; overflow: hidden; }
  .bar-fill { height: 100%; width: 20%; background: var(--accent); border-radius: 3px; transition: width 0.3s; }
  .counter { font-size: 13px; color: var(--text-muted); min-width: 32px; }
  .q-text { font-size: 18px; font-weight: 500; line-height: 1.6; margin: 0 0 1.25rem; }
  .options { display: flex; flex-direction: column; gap: 10px; }
  .options button { text-align: left; padding: 12px 16px; font-size: 15px; line-height: 1.5; }
  .result-card { border-radius: var(--radius); padding: 1.75rem; }
  .result-card .pos { font-size: 13px; margin: 0 0 8px; opacity: 0.85; }
  .result-card .stage { font-size: 24px; font-weight: 500; margin: 0 0 14px; }
  .result-card .desc { font-size: 15px; line-height: 1.7; margin: 0; }
  .choke {
    margin-top: 1rem; border-left: 3px solid #993c1d; padding: 12px 16px;
    background: var(--surface); border-radius: 0;
  }
  .choke .ct { font-size: 14px; font-weight: 500; margin: 0 0 6px; }
  .choke .cb { font-size: 14px; color: var(--text-muted); line-height: 1.6; margin: 0; }
  .actions { display: flex; gap: 10px; margin-top: 1.25rem; flex-wrap: wrap; }
  .actions a { text-decoration: none; }
  .actions button { background: transparent; }
  .hidden { display: none; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

  .s1 { background: #f1efe8; color: #2c2c2a; }
  .s2 { background: #e6f1fb; color: #042c53; }
  .s3 { background: #e1f5ee; color: #04342c; }
  .s4 { background: #eeedfe; color: #26215c; }
  .s5 { background: #faece7; color: #4a1b0c; }
  .s6 { background: #fbeaf0; color: #4b1528; }
  @media (prefers-color-scheme: dark) {
    .s1 { background: #444441; color: #f1efe8; }
    .s2 { background: #0c447c; color: #e6f1fb; }
    .s3 { background: #085041; color: #e1f5ee; }
    .s4 { background: #3c3489; color: #eeedfe; }
    .s5 { background: #712b13; color: #faece7; }
    .s6 { background: #72243e; color: #fbeaf0; }
  }

  .lmo { margin-top: 2.5rem; font-size: 13px; color: var(--text-muted); }
  .lmo summary { cursor: pointer; }
</style>

<script>
  interface Question {
    q: string;
    opts: Array<{ t: string; s: number }>;
  }

  interface Stage {
    name: string;
    cls: string;
    desc: string;
    choke?: boolean;
  }

  type StageKey = 1 | 2 | 3 | 4 | 5 | 6;

  (function () {
    const questions: Question[] = [
      {
        q: "지난 한 주를 떠올려보면, AI를 어떻게 썼나요?",
        opts: [
          { t: "거의 안 썼다", s: 1 },
          { t: "궁금한 걸 검색 대신 물어봤다", s: 2 },
          { t: "글 초안·요약·번역 같은 작업을 시켰다", s: 3 },
          { t: "반복 업무 일부를 AI가 처리하도록 짜뒀다", s: 4 },
          { t: "AI로 도구나 서비스를 직접 만들었다", s: 5 },
          { t: "AI가 스스로 돌아가는 시스템을 운영했다", s: 6 },
        ],
      },
      {
        q: "AI에게 일을 맡길 때, 당신과 AI의 관계에 가장 가까운 건?",
        opts: [
          { t: "맡길 일이 없다 / 안 맡긴다", s: 1 },
          { t: "내가 일하다 막히면 물어보는 정도", s: 2 },
          { t: "단발 작업을 던지고 결과를 받아 쓴다", s: 3 },
          { t: "내 업무 흐름의 일부를 아예 AI에 넘겼다", s: 4 },
          { t: "AI가 할 일을 내가 코드/도구로 설계한다", s: 5 },
          { t: "AI들이 서로 일을 주고받게 구성했다", s: 6 },
        ],
      },
      {
        q: '"이 일을 AI에 맡겨도 될까?" 할 때 당신은?',
        opts: [
          { t: "그런 고민을 해본 적 없다", s: 1 },
          { t: "답이 맞나 정도만 눈으로 확인한다", s: 2 },
          { t: "결과물을 받아 내가 손봐서 쓴다", s: 3 },
          { t: "검증 없이 맡기는 구간을 만들어 신뢰한다", s: 4 },
          { t: "맡길 부분/내 부분을 분해해 시스템화한다", s: 5 },
          { t: "검증조차 다른 AI에게 교차로 시킨다", s: 6 },
        ],
      },
      {
        q: 'AI로 무언가를 "만들어" 본 경험은?',
        opts: [
          { t: "없다", s: 2 },
          { t: "프롬프트로 글·이미지 결과물을 받은 정도", s: 3 },
          { t: "노코드/바이브코딩으로 간단한 걸 만들어봤다", s: 4 },
          { t: "웹·앱·자동화 도구를 직접 완성했다", s: 5 },
          { t: "에이전트나 자동화 시스템까지 구축했다", s: 6 },
        ],
      },
      {
        q: "당신이 AI에 대해 통제하는 대상은 주로?",
        opts: [
          { t: "딱히 없다", s: 1 },
          { t: "그때그때 내 질문", s: 2 },
          { t: "맡길 작업의 지시문(프롬프트)", s: 3 },
          { t: "업무 프로세스 어디를 AI에 넘길지", s: 4 },
          { t: "AI가 돌아가는 도구·코드 자체", s: 5 },
          { t: "여러 에이전트의 역할·위임·견제 구조", s: 6 },
        ],
      },
    ];

    const stages: Record<StageKey, Stage> = {
      1: {
        name: "1단계 · 안 쓴다",
        cls: "s1",
        desc: "아직 AI를 일상에 들이지 않은 단계입니다. 나쁜 게 아니라, 가장 큰 점프가 남아있는 자리예요. 다음 한 칸은 의외로 쉽습니다 — 검색하던 걸 한 번 AI에 물어보는 것부터.",
      },
      2: {
        name: "2단계 · 묻는다",
        cls: "s2",
        desc: "검색 대신 AI에게 묻기 시작한 단계. AI를 '더 똑똑한 검색창'으로 쓰고 있습니다. 다음 칸은 묻기에서 시키기로 — 답을 받는 걸 넘어, 초안·요약 같은 작업을 맡겨보세요.",
      },
      3: {
        name: "3단계 · 시킨다",
        cls: "s3",
        choke: true,
        desc: "단발 작업을 AI에 맡기는 단계. 여기서 체감 생산성이 확 오르죠. 그래서 대부분 여기 머뭅니다. 바로 다음 칸이 가장 넘기 어려운 벽입니다 — 아래를 꼭 읽어보세요.",
      },
      4: {
        name: "4단계 · 일을 맡긴다",
        cls: "s4",
        desc: "가장 많은 사람이 못 넘는 벽을 넘었습니다. 단발 작업을 넘어 업무 흐름 자체를 AI 중심으로 재설계한 단계. 도구를 쓰는 걸 넘어 일하는 방식을 바꾼 거예요. 다음은 직접 만들기입니다.",
      },
      5: {
        name: "5단계 · 만든다",
        cls: "s5",
        desc: "AI로 도구·서비스를 직접 만드는 단계. 소비자에서 생산자로 넘어왔습니다. 개발자는 코드로, 비개발자는 노코드로 오는 길이 다를 뿐 같은 단계예요. 마지막 칸은 'AI가 스스로 일하게' 만드는 것.",
      },
      6: {
        name: "6단계 · AI가 일하게 만든다",
        cls: "s6",
        desc: "꼭대기입니다. AI가 스스로 작업하는 시스템을 구축한 단계. 다만 여기도 폭이 넓어요 — 자동화 하나를 끼운 것부터, 여러 에이전트가 서로 일을 주고받는 조직까지. 같은 6단계 안에서도 층이 있습니다.",
      },
    };

    const stageLinks: Record<StageKey, string> = {
      1: "#단계-1-안-쓴다",
      2: "#단계-2-묻는다",
      3: "#단계-3-시킨다",
      4: "#단계-4-일을-맡긴다",
      5: "#단계-5-만든다",
      6: "#단계-6-ai가-일하게-만든다",
    };

    let current = 0;
    const answers: number[] = [];
    const intro = document.getElementById("intro") as HTMLElement;
    const quiz = document.getElementById("quiz") as HTMLElement;
    const resultEl = document.getElementById("result") as HTMLElement;
    const qText = document.getElementById("q-text") as HTMLElement;
    const optionsEl = document.getElementById("options") as HTMLElement;
    const bar = document.getElementById("bar") as HTMLElement;
    const counter = document.getElementById("counter") as HTMLElement;
    const startBtn = document.getElementById("start-btn") as HTMLButtonElement;

    startBtn!.addEventListener("click", function () {
      intro!.classList.add("hidden");
      quiz!.classList.remove("hidden");
      render();
    });

    function render() {
      const item = questions[current];
      qText!.textContent = item.q;
      counter!.textContent = (current + 1) + "/" + questions.length;
      bar!.style.width = (((current + 1) / questions.length) * 100) + "%";
      optionsEl!.innerHTML = "";
      item.opts.forEach(function (o) {
        const b = document.createElement("button");
        b.textContent = o.t;
        b.addEventListener("click", function () {
          answers.push(o.s);
          current++;
          if (current < questions.length) {
            render();
          } else {
            finish();
          }
        });
        optionsEl!.appendChild(b);
      });
    }

    function finish() {
      quiz!.classList.add("hidden");
      const avg = answers.reduce(function (a, b) {
        return a + b;
      }, 0) / answers.length;
      const s = Math.max(1, Math.min(6, Math.round(avg))) as StageKey;
      const st = stages[s];
      resultEl!.classList.remove("hidden");

      let chokeHtml = "";
      if (st.choke) {
        chokeHtml =
          '<div class="choke"><p class="ct">3 → 4, 대부분이 여기서 멈춥니다</p>' +
          "<p class=\"cb\">시키기는 'AI가 도구, 내가 주체'입니다. 맡기기는 '일 자체를 AI가 하도록 다시 짜기'예요. " +
          "능력이 아니라 사고방식이 바뀌어야 해서, AI를 잘 쓰는 사람도 평생 안 넘기도 합니다.</p></div>";
      }

      const shareText = encodeURIComponent("나는 AI 활용 " + s + "단계. 당신은?");
      const shareUrl = encodeURIComponent(location.href);

      resultEl!.innerHTML =
        '<div class="result-card ' +
        st.cls +
        '">' +
        '<p class="pos">당신의 현재 위치</p>' +
        '<p class="stage">' +
        st.name +
        "</p>" +
        '<p class="desc">' +
        st.desc +
        "</p></div>" +
        chokeHtml +
        '<div class="actions">' +
        '<button id="retry">↻ 다시 진단</button>' +
        '<a href="' +
        (stageLinks[s] || "#") +
        '"><button>' +
        s +
        "단계 더 알아보기</button></a>" +
        '<a href="https://twitter.com/intent/tweet?text=' +
        shareText +
        "&url=" +
        shareUrl +
        '" target="_blank" rel="noopener"><button>결과 공유</button></a>' +
        "</div>";

      const retryBtn = document.getElementById("retry") as HTMLButtonElement;
      retryBtn!.addEventListener("click", function () {
        answers.length = 0;
        current = 0;
        resultEl!.classList.add("hidden");
        resultEl!.innerHTML = "";
        quiz!.classList.remove("hidden");
        render();
      });
    }
  })();
</script>
