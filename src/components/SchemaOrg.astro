---
// Schema.org JSON-LD 자동 주입.
// type=BlogPosting (포스트) | WebSite (홈) | CollectionPage (블로그 인덱스)
// AI 에이전트와 검색엔진이 신뢰할 수 있는 구조화 데이터를 한 곳에서 발급.

interface PostingProps {
  type: 'BlogPosting';
  url: string;
  title: string;
  description: string;
  author: string;
  pubDate: Date;
  updatedDate?: Date;
  image?: string;
  tags?: string[];
  category?: string;
  siteName: string;
  siteUrl: string;
}

interface WebSiteProps {
  type: 'WebSite';
  url: string;
  name: string;
  description: string;
}

interface CollectionProps {
  type: 'CollectionPage';
  url: string;
  name: string;
  description: string;
}

type Props = PostingProps | WebSiteProps | CollectionProps;

const props = Astro.props as Props;

function build(props: Props): Record<string, unknown> {
  if (props.type === 'BlogPosting') {
    return {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      mainEntityOfPage: { '@type': 'WebPage', '@id': props.url },
      headline: props.title,
      description: props.description,
      image: props.image,
      author: { '@type': 'Organization', name: props.author },
      publisher: {
        '@type': 'Organization',
        name: props.siteName,
        url: props.siteUrl,
      },
      datePublished: props.pubDate.toISOString(),
      dateModified: (props.updatedDate ?? props.pubDate).toISOString(),
      keywords: props.tags?.join(', '),
      articleSection: props.category,
      inLanguage: 'ko-KR',
    };
  }
  if (props.type === 'WebSite') {
    return {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      url: props.url,
      name: props.name,
      description: props.description,
      inLanguage: 'ko-KR',
    };
  }
  return {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    url: props.url,
    name: props.name,
    description: props.description,
    inLanguage: 'ko-KR',
  };
}

const json = build(props);
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(json)} />
