---
import '../styles/global.css';
import { defaultLang, localeTag, localizePath, type Lang } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  ogType?: 'website' | 'article';
  lang?: Lang;
  // 이 페이지의 모든 언어판 (자기 자신 포함). hreflang 상호 링크용.
  alternates?: { lang: Lang; url: string }[];
  // 이 페이지가 광고할 RSS 피드. 기술 블로그와 서비스 블로그는 피드가 갈리므로
  // 섹션마다 자기 피드를 알려야 한다 — 기본값을 그대로 두면 서비스 글이
  // 엔지니어링 피드를 구독하라고 안내하게 된다.
  feedPath?: string;
  feedTitle?: string;
}

const {
  title, description, canonical, image, ogType = 'website', lang = defaultLang, alternates = [],
  feedPath = '/rss.xml', feedTitle = 'Ascendy Blog',
} = Astro.props;
const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = image
  ? new URL(image, Astro.site).toString()
  : new URL('/og-default.png', Astro.site).toString();
const ogLocale = localeTag[lang].replace('-', '_');
const xDefault = alternates.find((a) => a.lang === defaultLang);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<script is:inline>
  // 첫 페인트 전에 저장된 테마 선택을 적용한다(라이트↔다크 깜빡임 방지).
  // 저장값이 없으면 아무것도 하지 않는다 — 그 경우 OS 설정을 그대로 따른다.
  try {
    var saved = localStorage.getItem('theme');
    if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
  } catch (e) {}
</script>

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />

<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content={ogLocale} />

{alternates.map((alt) => (
  <link rel="alternate" hreflang={alt.lang} href={alt.url} />
))}
{xDefault && <link rel="alternate" hreflang="x-default" href={xDefault.url} />}

{/* 검색엔진 소유확인 토큰. 설계상 페이지 소스에 공개되는 값이고(그래야
    크롤러가 읽는다), 도메인 제어권 없이는 아무 권한도 주지 않으므로
    크레덴셜이 아니다. 구글은 public/google*.html 파일 방식을 쓰고 있다. */}
<meta name="naver-site-verification" content="70b3f10c8d0f4399e43d10dc44021552be2a9964" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{/* 본 서비스(ascendy.ai)와 같은 로고 파일. 탭 아이콘이 서비스와 일치해야
    블로그가 같은 브랜드로 읽힌다. 직전 참조(favicon.svg)는 파일이 없어 404였다. */}
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="apple-touch-icon" href="/favicon.png" />
<link rel="alternate" type="application/rss+xml" title={feedTitle} href={localizePath(feedPath, lang)} />
